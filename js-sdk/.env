# ══════════════════════════════════════════════════════════
#  DocSpace JS SDK Samples — environment configuration
# ══════════════════════════════════════════════════════════

# ── Portal ─────────────────────────────────────────────────
# URL of your DocSpace instance (no trailing slash).
PORTAL_SRC=https://docspace-k2epim.onlyoffice.com

# ── Admin API key ───────────────────────────────────────────
# Personal access token with admin rights.
# Required for Managed Demo mode (creates temp users + rooms).
# Without this key the server runs without session management.
ADMIN_API_KEY=sk-ea86cb3702bef25c7d4f22517d3de1c5c8541f40ac47aefb7452919303541240

# ── Server ─────────────────────────────────────────────────
PORT=3030

# ── Demo session settings ───────────────────────────────────
DEMO_SESSION_TTL_MINUTES=30
DEMO_SESSION_IDLE_MINUTES=15
DEMO_SESSION_JANITOR_INTERVAL_SECONDS=60
DEMO_EMAIL_DOMAIN=demo.local
DEMO_COOKIE_NAME=sdk_demo_sid
DEMO_SESSION_STORE_PATH=.data/sessions.json
DEMO_RATE_LIMIT_MAX=3
DEMO_RATE_LIMIT_WINDOW_SECONDS=60

# ── Template files ──────────────────────────────────────────
# Upload these files to a "Templates" room on your DocSpace,
# then paste their numeric IDs below.
# Missing IDs are skipped — affected examples won't have a
# file pre-selected, but still work manually.
#
#   sample.docx  — any Word document
#   sample.xlsx  — Excel sheet with a few data rows
#   sample.pptx  — PowerPoint presentation
#   form.pdf     — fillable PDF form  (fields: FirstName, LastName, …)
#   template.pdf — PDF form template for batch-fill / web-form-to-pdf
#
TEMPLATE_ROOM_ID=2604871
TEMPLATE_FILE_DOCX=3718076
TEMPLATE_FILE_XLSX=3718075
TEMPLATE_FILE_PPTX=3718073
TEMPLATE_FILE_PDF_FORM=3753652
TEMPLATE_FILE_PDF_TEMPLATE=3718070

# ── Feature flags ───────────────────────────────────────────
# Show "Use your own portal" tab in the UI.
# Set to false when the stand is public-facing.
ALLOW_CUSTOM_PORTAL=true
